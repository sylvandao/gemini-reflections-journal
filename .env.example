# Gemini is BYOK: users enter their own Google AI Studio key in the UI.
# The app keeps it in tab memory only and never reads a server GEMINI_API_KEY.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
NEXT_PUBLIC_APP_URL="https://betterhuman.ai.studio"

# Firebase web configuration is public by design, but values are environment-specific.
# Restrict the web API key to the required Firebase APIs and approved web origins.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# GOOGLE_MAPS_API_KEY: Used server-side for Google Maps Geocoding & Places APIs.
# Never expose to client bundles. Get a key or demo key at https://mapsplatform.google.com
GOOGLE_MAPS_API_KEY=""

# ADMIN_EMAILS: Comma-separated list of admin emails with access to /admin
ADMIN_EMAILS="admin@example.com"

# External Notification Integrations (Slack / Discord / Email)
# Triggered when entries are tagged with "urgent", "crisis", or specific priority levels.
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
NOTIFICATION_EMAIL=""
GMAIL_NOTIFICATION_WEBHOOK=""
