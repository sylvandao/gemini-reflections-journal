rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check: checks if user has custom admin claim, or role == 'admin' in their user profile document
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents - hardened against privilege escalation
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // On creation, non-admins cannot assign themselves the admin role
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'user' ||
        isAdmin()
      );
      // On update, users cannot modify their own role or uid; only verified admins can change roles
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
      );
      allow delete: if isAdmin();

      // User interactions & chat messages with Gemini (strict isolation)
      match /interactions/{interactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Multi-turn journal entries & reflection sessions
      match /entries/{entryId} {
        allow read, write: if isOwner(userId) || isAdmin();

        // Nested turns or reflections within an entry
        match /turns/{turnId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }

      // User notification & weekly digest settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // System audit logs (Tamper-resistant append-only for users, read for admins)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin configuration & global settings
    match /admin_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
